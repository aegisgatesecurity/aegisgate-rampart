{
  "openapi": "3.0.3",
  "info": {
    "title": "AegisGate Rampart Detection API",
    "description": "Local AI security proxy — PII, secrets, XSS, and compliance detection",
    "version": "0.6.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "paths": {
    "/detect": {
      "post": {
        "summary": "Detect threats in text",
        "operationId": "detectText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Text to scan for threats" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detection results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_detections": { "type": "integer" },
                    "blocked": { "type": "boolean" },
                    "results": { "type": "array", "items": { "type": "object" } },
                    "compliance": { "type": "object" },
                    "latency_ms": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Get proxy statistics",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Proxy statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_requests": { "type": "integer" },
                    "intercepted": { "type": "integer" },
                    "passed_through": { "type": "integer" },
                    "detections": { "type": "integer" },
                    "blocked_requests": { "type": "integer" },
                    "ml_detections": { "type": "integer" },
                    "mode": { "type": "string" },
                    "start_time": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "operationId": "getReady",
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": { "type": "boolean" },
                    "mode": { "type": "string" },
                    "patterns": { "type": "integer" },
                    "ml_enabled": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready"
          }
        }
      }
    }
  }
}